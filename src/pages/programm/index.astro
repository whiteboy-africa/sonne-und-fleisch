---
// Das Programm als Liste — die Textfassung des Regals, auch ohne WebGL
// lesbar und von Suchmaschinen erfassbar.
import Seite from '../../layouts/Seite.astro';
import { programmListe, buchPfad } from '../../buecher';

// Neuester Band oben, aeltester unten. Die Nummer bleibt am Buch.
const eintraege = await programmListe();
---

<Seite
  titel="Programm"
  augenbraue={`${eintraege.length} ${eintraege.length === 1 ? 'Band' : 'Bände'}`}
  untertitel="Alle zwei Monate ein neuer Doppelband."
  beschreibung="Das vollständige Programm des Verlags Sonne und Fleisch."
  weit
>
  {
    eintraege.length === 0 ? (
      <p class="fliesstext">Das Programm wird gerade gesetzt.</p>
    ) : (
      <div class="programm">
        {eintraege.map(({ buch, nummer, titel, autor, seiten }) => (
          <a class="band" href={buchPfad(buch)}>
            <span class="band__umschlaege" aria-hidden="true">
              {seiten.map((seite) => (
                <span
                  class="band__ruecken"
                  style={`background: ${seite.cover_farbe}; border-right: 3px solid ${seite.akzent_farbe};`}
                >
                  {
                    seite.cover_bild && (
                      <img src={seite.cover_bild} alt="" loading="lazy" decoding="async" />
                    )
                  }
                </span>
              ))}
            </span>
            <span class="band__text">
              <span class="band__nummer">{nummer}</span>
              <h2>{titel}</h2>
              <p class="band__autor">{autor}</p>
              <p class="band__klappentext">{buch.data.klappentext}</p>
              {buch.data.rueckseite && (
                <p class="band__doppel">
                  {buch.data.blind ? 'Wendeband' : 'Doppelcover'}
                </p>
              )}
            </span>
            <span class="band__marge">
              <span
                class="band__stand"
                data-stand={buch.data.verfuegbarkeit}
              >
                {buch.data.verfuegbarkeit}
              </span>
              <br />
              {buch.data.format}
              {buch.data.preis && (
                <>
                  <br />
                  {buch.data.preis}
                </>
              )}
            </span>
          </a>
        ))}
      </div>
    )
  }
</Seite>
