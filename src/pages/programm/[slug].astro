---
// Eine Seite pro Band — und auf ihr stehen beide Geschichten. Ein
// Doppelband hat zwei Vorderseiten; die Seite behauptet das gleich im
// Titel und zeigt danach beide Umschlaege, spiegelbildlich gesetzt: erst
// Seite A (Text links, Umschlag rechts), dann Seite B (Umschlag links,
// Text rechts). Das ist die stille Uebersetzung des Wendens im Regal.
import { render } from 'astro:content';
import Seite from '../../layouts/Seite.astro';
import { alleBuecher, releasenummer, type Buch } from '../../buecher';

export async function getStaticPaths() {
  const buecher = await alleBuecher();
  return buecher.map((buch, position) => ({
    params: { slug: buch.id },
    props: { buch, nummer: releasenummer(position) },
  }));
}

interface Props {
  buch: Buch;
  nummer: string;
}

const { buch, nummer } = Astro.props;
const d = buch.data;
const hinten = d.rueckseite;
const { Content } = await render(buch);

const datum = d.erscheinungsdatum
  ? new Intl.DateTimeFormat('de-DE', { month: 'long', year: 'numeric' }).format(
      d.erscheinungsdatum,
    )
  : undefined;

// Titel und Namen als Paar. Bei einem gewoehnlichen Band bleibt es beim
// einen; schreibt eine Person beide Geschichten, steht sie nur einmal da.
const paarTitel = hinten ? `${d.titel} / ${hinten.titel}` : d.titel;
const autorHinten = hinten?.autor ?? d.autor;
const paarAutor =
  hinten && autorHinten !== d.autor ? `${d.autor} / ${autorHinten}` : d.autor;

const seiten = [
  {
    marke: 'Seite A',
    titel: d.titel,
    autor: d.autor,
    klappentext: d.klappentext,
    zitat: d.zitat,
    zitat_von: d.zitat_von,
    cover_bild: d.cover_bild,
    cover_farbe: d.cover_farbe,
    akzent_farbe: d.akzent_farbe,
  },
  ...(hinten
    ? [
        {
          marke: 'Seite B',
          titel: hinten.titel,
          autor: autorHinten,
          klappentext: hinten.klappentext,
          zitat: hinten.zitat ?? d.zitat,
          zitat_von: hinten.zitat_von ?? d.zitat_von,
          cover_bild: hinten.cover_bild,
          cover_farbe: hinten.cover_farbe ?? d.cover_farbe,
          akzent_farbe: hinten.akzent_farbe ?? d.akzent_farbe,
        },
      ]
    : []),
];

// Angaben gelten fuer den ganzen Band: ein Buchblock, ein Ruecken.
const angaben: Array<[string, string]> = [
  ['Format', d.format],
  ['Verfügbarkeit', d.verfuegbarkeit],
  ...(d.preis ? ([['Preis', d.preis]] as Array<[string, string]>) : []),
  ...(d.isbn ? ([['ISBN', d.isbn]] as Array<[string, string]>) : []),
  ...(datum ? ([['Erscheint', datum]] as Array<[string, string]>) : []),
  ...(d.uebersetzung_aus
    ? ([['Übersetzt aus', d.uebersetzung_aus]] as Array<[string, string]>)
    : []),
  ...(d.reihe ? ([['Reihe', d.reihe]] as Array<[string, string]>) : []),
];

// Die Bestellzeile richtet sich nach dem Zustand: kein Knopf, eine Zeile.
const bestellung =
  d.verfuegbarkeit === 'Vergriffen'
    ? { text: 'Vergriffen', link: undefined }
    : d.verfuegbarkeit === 'Vakant'
      ? {
          text: 'PDF an salve@sonneundfleisch.com',
          link: 'mailto:salve@sonneundfleisch.com',
        }
      : d.verfuegbarkeit === 'Verfügbar'
        ? { text: 'Bestellen', link: d.bestell_link }
        : { text: 'Vormerken', link: d.bestell_link };
---

<Seite
  titel={paarTitel}
  untertitel={paarAutor}
  augenbraue={`Aus dem Programm · ${nummer}`}
  beschreibung={d.klappentext}
  weit
>
  {
    seiten.map((seite, index) => (
      <>
        {index > 0 && (
          <div class="wende-trenner" aria-hidden="true">
            <span>A · B</span>
          </div>
        )}
        <article class:list={['bandblock', index > 0 && 'bandblock--gewendet']}>
          <div class="bandblock__text">
            <p class="bandblock__marke">{hinten ? seite.marke : 'Der Band'}</p>
            <h2>{seite.titel}</h2>
            <p class="bandblock__autor">{seite.autor}</p>
            <p class="fliesstext">{seite.klappentext}</p>
            <blockquote class="buchkopf__zitat">
              „{seite.zitat}“
              <cite>{seite.zitat_von}</cite>
            </blockquote>
          </div>
          <div
            class="bandblock__cover"
            style={`background: ${seite.cover_farbe}; border-right: 4px solid ${seite.akzent_farbe};`}
          >
            {seite.cover_bild && (
              <img src={seite.cover_bild} alt={`Umschlag von ${seite.titel}`} />
            )}
          </div>
        </article>
      </>
    ))
  }

  <div class="fliesstext bandblock__nachwort">
    <Content />
  </div>

  <dl class="angaben">
    {
      angaben.map(([bezeichnung, wert]) => (
        <div>
          <dt>{bezeichnung}</dt>
          <dd>{wert}</dd>
        </div>
      ))
    }
  </dl>

  <p class="bestellzeile">
    {
      bestellung.link ? (
        <a href={bestellung.link}>
          {bestellung.text} <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <span>{bestellung.text}</span>
      )
    }
  </p>

  {d.verfuegbarkeit === 'Vakant' && (
    <p class="bestellzeile__notiz">Antwort kommt. Vielleicht.</p>
  )}
</Seite>
