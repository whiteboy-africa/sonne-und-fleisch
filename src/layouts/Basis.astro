---
// Huelle aller Seiten: Kopfdaten, Schriften, Fundament-CSS.
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/anton/400.css';
import '@fontsource/source-serif-4/400.css';

/*
 * **Die Bedienschrift und was zum Vergleichen daneben liegt.**
 * `siteConfig.FONT_MONO` schaltet um. Space Mono ist die Entscheidung;
 * Plex und Fragment bleiben eingebunden, damit der Weg zurueck eine
 * Zeile in der Konfiguration ist und kein Wiedereinbau.
 *
 * Geladen wird nach Teilmengen — `latin` und `latin-ext` —, nicht als
 * ganze Familie: Deutsch braucht Umlaute, das Eszett und die
 * Anfuehrungszeichen unten/oben, und die stehen alle in `latin`;
 * `latin-ext` kommt fuer die Namen dazu, die es darueber hinaus gibt.
 *
 * Was jede Schrift mitbringt, ist verschieden, und das entscheidet ueber
 * die Bedienung: Plex hat 400/500/600, **Space Mono 400 und 700**,
 * Fragment Mono einen einzigen Schnitt. Space Mono hat kein 500 — was
 * die Seite an Marken auf 500 setzt, wird deshalb auf 700 abgebildet
 * und was Fliesstext ist auf 400. Die Tafel dazu steht in `basis.css`.
 *
 * Courier Prime ist raus. Es traegt auf Schwarz nicht: bei 8 und 9 px
 * war es eher Schleier als Schrift, und der fette Schnitt, mit dem es
 * doch stand, war eine andere Seite.
 */
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-ext-500.css';
import '@fontsource/ibm-plex-mono/latin-ext-600.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';
import '@fontsource/space-mono/latin-ext-400.css';
import '@fontsource/space-mono/latin-ext-700.css';
import '@fontsource/fragment-mono/latin-400.css';
import '@fontsource/fragment-mono/latin-ext-400.css';

import '../styles/basis.css';
import { siteConfig } from '../shelf/verlag-config';

interface Props {
  titel?: string;
  beschreibung?: string;
  /** Dunkle Statusleiste und kein Scrollen — nur fuer das Regal. */
  regal?: boolean;
}

const { titel, beschreibung, regal = false } = Astro.props;

const seitenTitel = titel
  ? `${titel} — ${siteConfig.applicationName}`
  : siteConfig.title;
const seitenBeschreibung = beschreibung ?? siteConfig.description;
const kanonisch = new URL(Astro.url.pathname, Astro.site).href;

/*
 * **Das Bild, das beim Teilen erscheint.** Absolut, nicht relativ: wer
 * einen Link in WhatsApp oder Signal einwirft, holt das Bild von aussen,
 * und ein Pfad ohne Herkunft fuehrt dort nirgendwohin.
 */
const teilebild = new URL('/marke/teilen.jpg', Astro.site).href;
---

<!doctype html>
<html lang="de" data-mono={siteConfig.FONT_MONO}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitenTitel}</title>
    <meta name="description" content={seitenBeschreibung} />
    <link rel="canonical" href={kanonisch} />
    {
      /* Nicht auffindbar, solange der Verlag nicht oeffentlich ist. Der
         Riegel steht in verlag-config.ts und zusaetzlich in
         public/_headers, damit auch Bilder aussen vor bleiben. */
      !siteConfig.suchmaschinen && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.applicationName} />
    <meta property="og:title" content={seitenTitel} />
    <meta property="og:description" content={seitenBeschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={teilebild} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Ein geöffneter Mund, auf den Gaumen projiziert: SONNE + FLEISCH"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={teilebild} />

    {
      /*
       * **Kein SVG mehr.** `favicon.svg` (die gezeichnete Sonne) liegt
       * noch unter `public/`, ist aber nicht mehr verlinkt: sobald ein
       * Browser ein SVG-Icon angeboten bekommt, nimmt er das und nie das
       * PNG daneben. Das Zeichen des Verlags ist jetzt das Foto.
       *
       * Der enge Ausschnitt ist Absicht — siehe `scripts/marke-bauen.mjs`.
       * Der ganze Mund bei 32 Punkten waere ein rosa Fleck.
       */
    }
    <link rel="icon" href="/marke/icon-32.png" sizes="32x32" type="image/png" />
    <link
      rel="icon"
      href="/marke/icon-192.png"
      sizes="192x192"
      type="image/png"
    />
    <link rel="apple-touch-icon" href="/marke/icon-180.png" />
    {siteConfig.suchmaschinen && <link rel="sitemap" href="/sitemap-index.xml" />}
  </head>
  <body data-regalseite={regal ? 'ja' : undefined}>
    <slot />
  </body>
</html>
