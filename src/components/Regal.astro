---
// Das begehbare Regal. Das Markup steht vollstaendig im HTML, damit die
// Seite auch ohne WebGL lesbar bleibt; das Skript haengt nur die Bedienung
// und die 3D-Szene daran.
import type { CatalogBook } from '../shelf/katalog';
import { siteConfig } from '../shelf/verlag-config';

interface Props {
  katalog: CatalogBook[];
}

const { katalog } = Astro.props;
// Katalognummern: drei Stellen, fuehrende Nullen. 001, 002, 003.
const katalognummer = (zahl: number) => String(zahl).padStart(3, '0');
const erstes = katalog[0];
const gesamt = katalognummer(katalog.length);
---

<main class="press-experience is-browsing" data-regal>
  <script type="application/json" data-regal-daten set:html={JSON.stringify(katalog)} is:inline />

  <canvas
    class="shelf-canvas"
    data-regal-canvas
    role="application"
    tabindex="0"
    aria-label={`Stapel mit ${katalog.length} Bänden. Pfeiltasten blättern, Ziehen dreht die Ansicht, Eingabetaste holt den Band nach vorn.`}
  ></canvas>

  <header class="site-header">
    <a
      class="wordmark"
      href="/"
      aria-label={`${siteConfig.wordmark}, ${siteConfig.collectionName}`}
    >
      <span>{siteConfig.wordmark}</span>
      <span class="wordmark__divider"></span>
      <span>{siteConfig.collectionName}</span>
    </a>
    <div class="header-actions">
      <nav class="regal-nav" aria-label="Verlag">
        <a href="/programm">Programm</a>
        <a href="/verlag">Verlag</a>
        <a href="/kontakt">Kontakt</a>
      </nav>
    </div>
  </header>

  <section class="browse-caption" data-browse-caption>
    {/* Nur die Nummer des Bandes, der gerade vorn liegt — wie weit das
        Programm reicht, sagt die Leiste unten. */}
    <p class="eyebrow eyebrow--nummer">
      <span data-blaettern-zahl>{katalognummer(1)}</span>
    </p>
    <h1 data-blaettern-titel>{erstes.shortTitle}</h1>
    <p class="browse-caption__author" data-blaettern-autor>{erstes.author}</p>
  </section>

  {/* Nachbarschaft statt Pfeilkasten: am Rand steht die Nummer des Bandes
      nebenan, beim Darueberfahren kommt sein Titel dazu. Der sichtbare Text
      ist nur die Beschriftung — angeklickt wird ein breiter, unsichtbarer
      Streifen am Bildrand. Auf Fingergeraeten faellt beides weg, dort wird
      gewischt. */}
  <button type="button" class="nachbar nachbar--links" data-zurueck>
    <span class="nachbar__zeile">
      <span aria-hidden="true">‹</span>
      <span data-nachbar-zahl-zurueck>{katalognummer(katalog.length)}</span>
      <span class="nachbar__titel" data-nachbar-titel-zurueck></span>
    </span>
  </button>
  <button type="button" class="nachbar nachbar--rechts" data-vor>
    <span class="nachbar__zeile">
      <span class="nachbar__titel" data-nachbar-titel-vor></span>
      <span data-nachbar-zahl-vor>{katalognummer(2)}</span>
      <span aria-hidden="true">›</span>
    </span>
  </button>

  <nav class="shelf-index" aria-label="Platz im Stapel">
    <div class="shelf-index__ticks">
      {
        katalog.map((buch, index) => (
          <button
            type="button"
            data-tick
            class={index === 0 ? 'is-active' : ''}
            aria-label={`Zu ${buch.title} blättern`}
            aria-current={index === 0 ? 'true' : undefined}
          >
            <span></span>
            <b>{katalognummer(index + 1)}</b>
          </button>
        ))
      }
      {/* Die Linie hoert nicht am letzten Band auf: sie laeuft weiter und
          wird vom Bildrand angeschnitten. Darauf sitzt eine gedimmte
          Marke fuer den naechsten Band — eine Linie, die am Rand endet
          statt am letzten Eintrag, verspricht von selbst Fortsetzung. */}
      <span class="shelf-index__weiter" aria-hidden="true">
        <span></span>
        <b>{katalognummer(katalog.length + 1)}</b>
      </span>
    </div>
    {/* Kein Bedienhinweis: Pfeile und Leiste zeigen das Blättern von
        selbst, und die Beschriftung der Fläche sagt es Vorlesegeräten.
        Hier steht stattdessen die Parole. */}
    <a class="slogan" href="/deterritorialization">{siteConfig.slogan}</a>
  </nav>

  {/* Der Weg zurueck steht ausserhalb der Tafel: die hat eine
      Transformation, und darin waere er an sie gefesselt. Hier oben kann
      er ueber dem Band stehen. */}
  <button type="button" class="back-button" data-zum-regal>
    <span aria-hidden="true" class="arrow-icon arrow-icon--left"><span></span></span>
    <span>Zurück zum Stapel</span>
  </button>

  {/* Kurzer Hinweis beim Aufschlagen: dass man weiterwischen kann, sieht
      man dem Bild sonst nicht an. Nur auf Geraeten mit Fingerbedienung. */}
  <p class="wisch-hinweis" data-wisch-hinweis aria-hidden="true"></p>

  <aside class="book-details" data-panel aria-hidden="true" aria-label="Angaben zum Band">
    <div class="book-details__inner" data-panel-inhalt hidden>
      <div class="book-details__copy" data-panel-text>
        {/* Oben der wechselnde Inhalt: er darf verschieden lang sein. */}
        <div class="book-details__oben">
        {/* Statt „Aus dem Programm" steht hier die Nummer des Bandes. */}
        <p class="eyebrow">
          <span data-panel-augenbraue>{katalognummer(1)}</span>
          <span class="seitenmarke seitenmarke--kopf" data-seitenmarke hidden>Seite A</span>
        </p>
        <h2 data-panel-titel></h2>
        <p class="book-details__author">
          <span data-panel-autor></span>
          <span class="seitenmarke seitenmarke--autor" data-seitenmarke hidden>Seite A</span>
        </p>
        <p class="book-details__description" data-panel-klappentext></p>

        <blockquote>
          <p data-panel-zitat></p>
          <cite data-panel-zitat-von></cite>
        </blockquote>

        </div>

        {/* Unten der feste Block: er steht bei jedem Band und auf beiden
            Seiten an derselben Stelle. Sonst springt der Wenden-Schalter
            beim Wenden unter dem Zeiger weg. */}
        <div class="book-details__unten">
        <dl>
          <div>
            <dt>Format</dt>
            <dd data-panel-format></dd>
          </div>
          <div>
            <dt>Verfügbarkeit</dt>
            <dd data-panel-verfuegbarkeit></dd>
          </div>
        </dl>

        {/* Wenden: dreht den Band um und auf den Kopf. Bei Doppelbänden
            wechselt damit auch die Beschreibung auf die andere Geschichte. */}
        <button type="button" class="wenden-knopf" data-wenden>
          <span aria-hidden="true">⟳</span>
          <span data-wenden-text>Band wenden</span>
          <kbd aria-hidden="true">F</kbd>
        </button>

        <a class="official-link" data-panel-link href="/programm">
          <span data-panel-link-text>{siteConfig.bookLinkLabel}</span>
          <span aria-hidden="true">↗</span>
        </a>
        </div>
      </div>


    </div>
  </aside>

  {/* Nur noch fuer Vorlesegeraete: die Meldung sagt, was gerade passiert.
      Im Bild stand sie bloss im Weg. */}
  <div class="experience-status nur-vorlesen" role="status" aria-live="polite">
    <span data-status-text>Der Stapel wird aufgebaut</span>
  </div>

  <div class="loading-screen" data-ladeschirm aria-hidden="false">
    <div class="loading-screen__mark">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <p>{katalog.length} {katalog.length === 1 ? 'Band' : 'Bände'} werden gestellt</p>
  </div>

  {/* Ausweg, wenn kein WebGL zur Verfügung steht oder die Szene abstürzt.
      Ohne ihn bliebe hier eine schwarze Fläche stehen. */}
  <div class="ohne-3d-ausweg" data-ausweg hidden>
    <p>Dieses Gerät kann den Stapel nicht aufbauen.</p>
    <a href="/programm">Zum Programm als Liste</a>
  </div>

  <div class="sr-only" aria-live="polite" data-vorlese></div>
</main>

<script>
  import { regalStarten } from '../shelf/mount';

  const wurzel = document.querySelector<HTMLElement>('[data-regal]');
  if (wurzel) regalStarten(wurzel);
</script>
